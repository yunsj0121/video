# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 .gitignore 에 포함되어 커밋되지 않습니다)
# 나레이션 엔진: edge(무료, 기본) | elevenlabs(유료) | silent(무음 테스트)
# 비워두면 ELEVENLABS_API_KEY 가 있으면 elevenlabs, 없으면 edge
TTS_PROVIDER=
# edge 음성: ko-KR-SunHiNeural(여) | ko-KR-InJoonNeural(남) | ko-KR-HyunsuMultilingualNeural(남)
EDGE_VOICE=ko-KR-SunHiNeural

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# 한글 폰트 경로 (선택) — 비워두면 assets/fonts → 시스템 폰트 순으로 찾습니다
FONT_BOLD=
FONT_REGULAR=

# ffmpeg 경로 (선택) — 비워두면 PATH → imageio-ffmpeg 순으로 찾습니다
FFMPEG_BIN=
