# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 커밋하지 않습니다)
# Google 영상 생성: Flow 웹앱이 아닌 공식 Gemini API로 같은 Veo 모델을 호출합니다
GEMINI_API_KEY=
GOOGLE_VIDEO_MODEL=veo-3.1-generate-preview

# 나레이션 엔진: edge(무료, 기본) | elevenlabs(유료) | silent(무음 테스트)
TTS_PROVIDER=
EDGE_VOICE=ko-KR-SunHiNeural
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

FONT_BOLD=
FONT_REGULAR=
FFMPEG_BIN=
